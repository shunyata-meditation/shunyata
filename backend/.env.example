# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of trusted origins for CSRF (must include scheme, e.g. https://example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=
# Comma-separated browser origins allowed to call the API (must include scheme)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database Settings (PostgreSQL)
DB_NAME=shunyata
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432
# Use "require" for hosted databases like Neon that require SSL (set to "prefer" for local dev)
DB_SSLMODE=prefer

# Email Settings (Resend)
RESEND_API_KEY=your-resend-api-key-here

# Email Verification Settings
VERIFICATION_EMAIL_EXPIRY_HOURS=24
FRONTEND_URL=http://localhost:3000
